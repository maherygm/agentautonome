# Variables front (Vite). Préfixe VITE_ pour exposition au client.
# Copier vers web/.env si besoin :
#   cp web/.env.example web/.env
#
# Par défaut le proxy Vite pointe déjà vers l'API locale (voir vite.config.ts).
# Décommente seulement si tu changes l'URL de l'API.

# VITE_API_PROXY_TARGET=http://127.0.0.1:8000
